{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OldenEraTemplates",
  "version": "1.0.0",
  "identifier": "com.rannes.olden-era-templates",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5230",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Olden Era — Генератор шаблонов",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rannes/olden-era-templates/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NDZCOEYxNjgxMTY5RUEKUldUcWFSRm84YmhHNUc2VytMWXRSWUhaZDBJbGFrMTh0SVBQdXpHbXhzVGgzMjJNNEJOUzl0MVgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}